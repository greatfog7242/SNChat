<Window x:Class="SNChat.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SNChat.App"
        xmlns:views="clr-namespace:SNChat.App.Views"
        mc:Ignorable="d"
        Title="SNChat - AI Chat Assistant"
        Height="700"
        Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Conversation List Sidebar -->
        <views:ConversationListView Grid.Column="0" x:Name="ConversationListControl"/>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Stretch"
                      Background="#E0E0E0"/>

        <!-- Chat View -->
        <views:ChatView Grid.Column="2" x:Name="ChatViewControl"/>
    </Grid>
</Window>
