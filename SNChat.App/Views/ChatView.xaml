<UserControl x:Class="SNChat.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SNChat.App.Views"
             xmlns:viewmodels="clr-namespace:SNChat.App.ViewModels"
             xmlns:models="clr-namespace:SNChat.Core.Models;assembly=SNChat.Core"
             xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
             xmlns:behaviors="clr-namespace:SNChat.App.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewmodels:ChatViewModel}"
             AllowDrop="True"
             DragOver="ChatView_DragOver"
             DragLeave="ChatView_DragLeave"
             Drop="ChatView_Drop">
    <UserControl.Resources>
        <!-- Markdown Styles -->
        <Style x:Key="MarkdownViewerStyle" TargetType="markdig:MarkdownViewer">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Code block style -->
        <Style x:Key="CodeBlockStyle" TargetType="Paragraph">
            <Setter Property="Background" Value="#F6F8FA"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Inline code style -->
        <Style x:Key="InlineCodeStyle" TargetType="Run">
            <Setter Property="Background" Value="#F6F8FA"/>
            <Setter Property="Foreground" Value="#E83E8C"/>
            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="UserMessageStyle" TargetType="Border">
            <Setter Property="Background" Value="#E3F2FD"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="50,5,10,5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="AssistantMessageStyle" TargetType="Border">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="10,5,50,5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="MessageTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>

        <DataTemplate x:Key="MessageTemplate">
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Role}" Value="User">
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="Margin" Value="50,5,10,5"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Role}" Value="Assistant">
                                <Setter Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Margin" Value="10,5,50,5"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Role}" Value="System">
                                <Setter Property="Background" Value="#FFF9C4"/>
                                <Setter Property="Margin" Value="10,5,10,5"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Padding" Value="12"/>
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <TextBlock Text="{Binding Role}" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,4"/>
                    <markdig:MarkdownViewer Markdown="{Binding Content}"
                                           FontSize="14"
                                           FontFamily="Segoe UI"
                                           Foreground="#333333"
                                           Background="Transparent"
                                           behaviors:CodeBlockCopyBehavior.Enabled="True"/>

                    <!-- Display attached images -->
                    <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,8"
                                        BorderBrush="#CCCCCC"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Background="White">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:AttachmentType.Image}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Image Source="{Binding FilePath, Converter={StaticResource FilePathToUriConverter}}"
                                               MaxWidth="400"
                                               MaxHeight="400"
                                               Stretch="Uniform"
                                               Margin="4"/>
                                        <TextBlock Text="{Binding FileName}"
                                                   FontSize="10"
                                                   Opacity="0.6"
                                                   Margin="4,0,4,4"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Footer: timestamp plus copy actions revealed on hover -->
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}"
                                   FontSize="10" Opacity="0.5" VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Button Content="Copy code"
                                    FontSize="10"
                                    Padding="6,2"
                                    Margin="0,0,6,0"
                                    Cursor="Hand"
                                    ToolTip="Copy just the code blocks from this message"
                                    Visibility="{Binding Content, Converter={StaticResource HasCodeBlocksConverter}}"
                                    Command="{Binding DataContext.CopyCodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>

                            <Button Content="Copy"
                                    FontSize="10"
                                    Padding="6,2"
                                    Cursor="Hand"
                                    ToolTip="Copy the whole message"
                                    Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Drop hint, shown while files are dragged over the view -->
        <Border x:Name="DropOverlay"
                Grid.RowSpan="3"
                Panel.ZIndex="100"
                Background="#CC2196F3"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="📎" FontSize="42" HorizontalAlignment="Center" Foreground="White"/>
                <TextBlock Text="Drop files to attach them"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,10,0,0"/>
                <TextBlock Text="Text and code files are read; other types are attached by name only"
                           FontSize="11"
                           Foreground="#E3F2FD"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="⚙ Settings"
                            Click="SettingsButton_Click"
                            Padding="10,5"
                            Margin="0,0,10,0"
                            ToolTip="Open settings and templates (Ctrl+T for templates)"/>

                    <!-- Shown only while a template's system prompt is active -->
                    <Border Background="#E8F5E9"
                            BorderBrush="#A5D6A7"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="6,3"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasSystemPrompt, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ActiveTemplateName}"
                                       FontSize="11"
                                       Foreground="#2E7D32"
                                       VerticalAlignment="Center"/>
                            <Button Content="✕"
                                    Command="{Binding ClearTemplateCommand}"
                                    FontSize="9"
                                    Padding="4,0"
                                    Margin="6,0,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#2E7D32"
                                    Cursor="Hand"
                                    ToolTip="Clear this template's system prompt"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding CurrentConversation.Title}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Margin="0,0,20,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Provider:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox ItemsSource="{Binding AvailableProviders}"
                                  SelectedItem="{Binding CurrentProviderName}"
                                  MinWidth="100"
                                  VerticalAlignment="Center"
                                  IsEnabled="{Binding IsStreaming, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Model:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox ItemsSource="{Binding AvailableModels}"
                                  SelectedItem="{Binding CurrentModel}"
                                  MinWidth="180"
                                  VerticalAlignment="Center"
                                  IsEnabled="{Binding IsStreaming, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Messages Area -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="10"
                      Background="White"
                      x:Name="MessageScrollViewer"
                      PreviewMouseWheel="MessageScrollViewer_PreviewMouseWheel">
            <ItemsControl ItemsSource="{Binding Messages}"
                          ItemTemplate="{StaticResource MessageTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- Input Area -->
        <Border Grid.Row="2"
                Background="#F9F9F9"
                BorderBrush="#CCCCCC"
                BorderThickness="0,1,0,0"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Queued attachments, shown until the message is sent -->
                <ItemsControl Grid.Row="0"
                              ItemsSource="{Binding PendingAttachments}"
                              Margin="0,0,0,6"
                              Visibility="{Binding HasPendingAttachments, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#E3F2FD"
                                    BorderBrush="#90CAF9"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="6,3"
                                    Margin="0,0,6,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📎" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding FileName}"
                                               FontSize="11"
                                               Foreground="#1565C0"
                                               VerticalAlignment="Center"
                                               MaxWidth="220"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Content="✕"
                                            FontSize="9"
                                            Padding="4,0"
                                            Margin="6,0,0,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#1565C0"
                                            Cursor="Hand"
                                            ToolTip="Remove this attachment"
                                            Command="{Binding DataContext.RemoveAttachmentCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBox Grid.Row="1"
                         x:Name="MessageInput"
                         Text="{Binding CurrentInput, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="60"
                         MaxHeight="150"
                         Padding="8"
                         FontSize="14"
                         PreviewKeyDown="MessageInput_PreviewKeyDown"
                         IsEnabled="{Binding IsStreaming, Converter={StaticResource InverseBooleanConverter}}">
                    <!-- Enter sends, Shift+Enter inserts a newline; handled in
                         code-behind because a KeyBinding cannot distinguish the
                         two without also swallowing the newline case. -->
                </TextBox>

                <Grid Grid.Row="2" Margin="0,5,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <!-- Compact streaming indicator -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsStreaming, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    VerticalAlignment="Center">
                            <TextBlock Text="⏳" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Generating..."
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#2196F3"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="10"
                                       Foreground="#666666"
                                       VerticalAlignment="Center"
                                       MaxWidth="200"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Disabled, not hidden, while streaming: the setting
                             stays visible so its state is readable mid-response. -->
                        <CheckBox Content="Tools"
                                  IsChecked="{Binding WebSearchEnabled}"
                                  VerticalAlignment="Center"
                                  Margin="10,0,0,0"
                                  ToolTip="Enable tools like web search for the model"
                                  IsEnabled="{Binding IsStreaming, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Enter to send · Shift+Enter for a new line"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   FontSize="11"
                                   Opacity="0.6"/>
                        <Button Content="Cancel"
                                Command="{Binding CancelGenerationCommand}"
                                Padding="20,8"
                                Margin="0,0,10,0"
                                FontWeight="SemiBold"
                                IsEnabled="{Binding IsStreaming}"/>
                        <Button Content="Send"
                                Command="{Binding SendMessageCommand}"
                                Padding="20,8"
                                FontWeight="SemiBold"
                                IsEnabled="{Binding IsStreaming, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
