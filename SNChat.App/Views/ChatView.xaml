<UserControl x:Class="SNChat.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SNChat.App.Views"
             xmlns:viewmodels="clr-namespace:SNChat.App.ViewModels"
             xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
             xmlns:behaviors="clr-namespace:SNChat.App.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewmodels:ChatViewModel}">
    <UserControl.Resources>
        <!-- Markdown Styles -->
        <Style x:Key="MarkdownViewerStyle" TargetType="markdig:MarkdownViewer">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Code block style -->
        <Style x:Key="CodeBlockStyle" TargetType="Paragraph">
            <Setter Property="Background" Value="#F6F8FA"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Inline code style -->
        <Style x:Key="InlineCodeStyle" TargetType="Run">
            <Setter Property="Background" Value="#F6F8FA"/>
            <Setter Property="Foreground" Value="#E83E8C"/>
            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="UserMessageStyle" TargetType="Border">
            <Setter Property="Background" Value="#E3F2FD"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="50,5,10,5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="AssistantMessageStyle" TargetType="Border">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="10,5,50,5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="MessageTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>

        <DataTemplate x:Key="MessageTemplate">
            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Role}" Value="User">
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="Margin" Value="50,5,10,5"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Role}" Value="Assistant">
                                <Setter Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Margin" Value="10,5,50,5"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Role}" Value="System">
                                <Setter Property="Background" Value="#FFF9C4"/>
                                <Setter Property="Margin" Value="10,5,10,5"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Padding" Value="12"/>
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <TextBlock Text="{Binding Role}" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,4"/>
                    <markdig:MarkdownViewer Markdown="{Binding Content}"
                                           FontSize="14"
                                           FontFamily="Segoe UI"
                                           Foreground="#333333"
                                           Background="Transparent"
                                           behaviors:CodeBlockCopyBehavior.Enabled="True"/>

                    <!-- Footer: timestamp plus copy actions revealed on hover -->
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}"
                                   FontSize="10" Opacity="0.5" VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Button Content="Copy code"
                                    FontSize="10"
                                    Padding="6,2"
                                    Margin="0,0,6,0"
                                    Cursor="Hand"
                                    ToolTip="Copy just the code blocks from this message"
                                    Visibility="{Binding Content, Converter={StaticResource HasCodeBlocksConverter}}"
                                    Command="{Binding DataContext.CopyCodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>

                            <Button Content="Copy"
                                    FontSize="10"
                                    Padding="6,2"
                                    Cursor="Hand"
                                    ToolTip="Copy the whole message"
                                    Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="New Conversation"
                            Command="{Binding NewConversationCommand}"
                            Padding="10,5"
                            Margin="0,0,10,0"
                            ToolTip="Start a new conversation (Ctrl+N)"/>
                    <Button Content="Cancel"
                            Command="{Binding CancelGenerationCommand}"
                            Padding="10,5"
                            Margin="0,0,10,0"
                            IsEnabled="{Binding IsStreaming}"/>
                    <Button Content="⚙ Settings"
                            Click="SettingsButton_Click"
                            Padding="10,5"
                            Margin="0,0,10,0"/>
                    <CheckBox Content="🔎 Web search"
                              IsChecked="{Binding WebSearchEnabled}"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              ToolTip="Let the model search the web when it needs current information. Adds tool definitions to each request."
                              IsEnabled="{Binding IsStreaming, Converter={StaticResource InverseBooleanConverter}}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding CurrentConversation.Title}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Margin="0,0,20,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Provider:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox ItemsSource="{Binding AvailableProviders}"
                                  SelectedItem="{Binding CurrentProviderName}"
                                  MinWidth="100"
                                  VerticalAlignment="Center"
                                  IsEnabled="{Binding IsStreaming, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Model:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox ItemsSource="{Binding AvailableModels}"
                                  SelectedItem="{Binding CurrentModel}"
                                  MinWidth="180"
                                  VerticalAlignment="Center"
                                  IsEnabled="{Binding IsStreaming, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Messages Area -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="10"
                      Background="White"
                      x:Name="MessageScrollViewer"
                      PreviewMouseWheel="MessageScrollViewer_PreviewMouseWheel">
            <ItemsControl ItemsSource="{Binding Messages}"
                          ItemTemplate="{StaticResource MessageTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- Input Area -->
        <Border Grid.Row="2"
                Background="#F9F9F9"
                BorderBrush="#CCCCCC"
                BorderThickness="0,1,0,0"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0"
                         Text="{Binding CurrentInput, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="60"
                         MaxHeight="150"
                         Padding="8"
                         FontSize="14"
                         IsEnabled="{Binding IsStreaming, Converter={StaticResource InverseBooleanConverter}}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return"
                                    Modifiers="Control"
                                    Command="{Binding SendMessageCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                    <TextBlock Text="Ctrl+Enter to send"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               FontSize="11"
                               Opacity="0.6"/>
                    <Button Content="Send"
                            Command="{Binding SendMessageCommand}"
                            Padding="20,8"
                            FontWeight="SemiBold"
                            IsEnabled="{Binding IsStreaming, Converter={StaticResource InverseBooleanConverter}}"/>
                </StackPanel>

                <!-- Streaming indicator overlay on input area -->
                <Border Grid.Row="0"
                        Grid.RowSpan="2"
                        Background="#80000000"
                        Visibility="{Binding IsStreaming, Converter={StaticResource BooleanToVisibilityConverter}}"
                        CornerRadius="4">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⏳ Generating response..."
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#FFD966"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                        <ProgressBar IsIndeterminate="True"
                                     Width="200"
                                     Height="4"
                                     Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
