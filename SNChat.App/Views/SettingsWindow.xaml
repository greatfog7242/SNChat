<Window x:Class="SNChat.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SNChat.App.Views"
        xmlns:viewmodels="clr-namespace:SNChat.App.ViewModels"
        mc:Ignorable="d"
        Title="Settings - SNChat"
        Height="550"
        Width="700"
        WindowStartupLocation="CenterOwner"
        d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Settings Content -->
        <TabControl Grid.Row="0" Margin="10">
            <!-- Provider Settings Tab -->
            <TabItem Header="Providers">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="LLM Provider API Keys" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <!-- Ollama needs no key, but it does need an address:
                             it is often served by another machine on the network. -->
                        <TextBlock Text="Ollama" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBlock Text="Server URL:" Margin="0,5,0,2"/>
                        <TextBox Text="{Binding OllamaBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666666" Margin="0,0,0,10"
                                   Text="http://localhost:11434 for this machine, or http://&lt;host&gt;:11434 for one on the network. The serving machine must run with OLLAMA_HOST=0.0.0.0 to accept connections from anywhere but itself. Takes effect after a restart."/>

                        <TextBlock Text="Context window (num_ctx):" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding OllamaContextWindow, UpdateSourceTrigger=PropertyChanged}"
                                 Width="200"
                                 HorizontalAlignment="Left"
                                 Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666666" Margin="0,0,0,6"
                                   Text="How much conversation Ollama keeps in mind, in tokens. Leave at 0 to let Ollama decide - but then nothing reports what it settled on, so the context meter has to assume the model's full trained length, which is usually more than you are really being served. Setting a figure here makes the meter exact, because the request asks for the same number the meter measures against."/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#B26500" Margin="0,0,0,20"
                                   Text="Raise this carefully. The memory Ollama needs grows with it, and a value your GPU cannot hold will push the model into system RAM - generation gets drastically slower, or the model fails to load. 8192 to 32768 suits most setups. Anything above what the model was trained for is ignored."/>

                        <!-- FreeToken -->
                        <TextBlock Text="FreeToken" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBlock Text="API Key:" Margin="0,5,0,2"/>
                        <PasswordBox x:Name="FreeTokenApiKeyBox" Margin="0,0,0,10"/>
                        <TextBlock Text="Base URL:" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding FreeTokenBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20"/>

                        <!-- OpenRouter -->
                        <TextBlock Text="OpenRouter" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBlock Text="API Key:" Margin="0,5,0,2"/>
                        <PasswordBox x:Name="OpenRouterApiKeyBox" Margin="0,0,0,10"/>
                        <TextBlock Text="Base URL:" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding OpenRouterBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <!-- Model picker: OpenRouter carries several hundred
                             tool-capable models, too many for a flat dropdown. -->
                        <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4"
                                Padding="10" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Models shown in the main window"
                                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666666"
                                           Margin="0,0,0,8"
                                           Text="Tick the models you actually use. With none ticked, every tool-capable model is offered, which is a very long list."/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Load models"
                                            Command="{Binding LoadOpenRouterModelsCommand}"
                                            Padding="10,4" Margin="0,0,8,0"
                                            IsEnabled="{Binding IsLoadingOpenRouterModels,
                                                        Converter={StaticResource InverseBooleanConverter}}"/>
                                    <Button Content="Clear selection"
                                            Command="{Binding ClearOpenRouterModelSelectionCommand}"
                                            Padding="10,4" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding OpenRouterModelFilter, UpdateSourceTrigger=PropertyChanged}"
                                             Width="180" Padding="6,3" VerticalContentAlignment="Center"
                                             ToolTip="Filter by model id"/>
                                </StackPanel>

                                <TextBlock Text="{Binding OpenRouterModelStatus}"
                                           FontSize="11" Foreground="#666666" TextWrapping="Wrap"
                                           Margin="0,0,0,6"/>

                                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,6"
                                             Visibility="{Binding IsLoadingOpenRouterModels,
                                                          Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- Fixed height with its own scrollbar: the list
                                     is long and would otherwise push the API key
                                     fields off the top of the tab. -->
                                <ScrollViewer Height="220" VerticalScrollBarVisibility="Auto"
                                              BorderBrush="#EEEEEE" BorderThickness="1">
                                    <ItemsControl ItemsSource="{Binding OpenRouterModels}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0"
                                                              Content="{Binding Id}"
                                                              IsChecked="{Binding IsSelected}"
                                                              VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Detail}"
                                                               FontSize="10" Foreground="#999999"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,4,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Anthropic -->
                        <TextBlock Text="Anthropic (Claude)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBlock Text="API Key:" Margin="0,5,0,2"/>
                        <PasswordBox x:Name="AnthropicApiKeyBox" Margin="0,0,0,20"/>

                        <!-- OpenAI -->
                        <TextBlock Text="OpenAI" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBlock Text="API Key:" Margin="0,5,0,2"/>
                        <PasswordBox x:Name="OpenAIApiKeyBox" Margin="0,0,0,10"/>

                        <TextBlock Text="Note: API keys are stored locally in plain text. Keep your computer secure."
                                   FontSize="11"
                                   Foreground="#666666"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Image Search Tab -->
            <TabItem Header="Search">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Web Search Source" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <TextBlock Text="Source:" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding WebSourceOptions}"
                                  SelectedItem="{Binding WebSource}"
                                  Width="240"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666666" Margin="0,0,0,10">
                            Google searches the whole web. DuckDuckGo + Wikipedia only cover subjects
                            that have an encyclopedia article, so niche topics return nothing.
                            Either way it falls back to the encyclopedic sources if Google finds nothing.
                        </TextBlock>

                        <CheckBox Content="SafeSearch (filters explicit results)"
                                  IsChecked="{Binding SafeSearch}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="Applies to Google web and image results only."
                                   FontSize="11" Foreground="#666666" Margin="20,0,0,20"/>

                        <Separator Margin="0,0,0,15"/>

                        <TextBlock Text="Image Search Source" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <TextBlock Text="Source:" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding ImageSourceOptions}"
                                  SelectedItem="{Binding ImageSource}"
                                  Width="240"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,0,6"/>
                        <TextBlock Text="Auto uses Google when credentials are set, otherwise Wikimedia Commons."
                                   FontSize="11" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <CheckBox Content="Fall back to Wikimedia Commons if the chosen source returns nothing"
                                  IsChecked="{Binding FallbackToCommons}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="Recommended - this also covers running out of Google's daily quota."
                                   FontSize="11" Foreground="#666666" TextWrapping="Wrap" Margin="20,0,0,20"/>

                        <Separator Margin="0,0,0,15"/>

                        <TextBlock Text="Google Programmable Search" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <TextBlock Text="API Key:" Margin="0,0,0,2"/>
                        <PasswordBox x:Name="GoogleApiKeyBox" Margin="0,0,0,10"/>

                        <TextBlock Text="Search Engine ID (cx):" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding GoogleSearchEngineId, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12"/>

                        <Border Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1"
                                Padding="10" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Setup" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#555555">
                                    1. Create an API key in Google Cloud Console and enable the Custom Search API.<LineBreak/>
                                    2. Create a search engine at programmablesearchengine.google.com and copy its ID.<LineBreak/>
                                    3. In that search engine, turn ON "Search the entire web" and enable Image search.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#B26500" Margin="0,6,0,0">
                                    Step 3 matters: a new search engine only looks at sites you list, so image
                                    searches come back empty until "Search the entire web" is enabled.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666666" Margin="0,12,0,0">
                            Google's free tier is limited per day. Wikimedia Commons needs no key and has no
                            quota, but only covers notable subjects - it has little stock or product imagery.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Default Parameters Tab -->
            <TabItem Header="Defaults">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Default LLM Parameters" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <TextBlock Text="Temperature:" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Slider Value="{Binding DefaultTemperature}"
                                    Minimum="0"
                                    Maximum="2"
                                    Width="300"
                                    TickFrequency="0.1"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DefaultTemperature, StringFormat='{}{0:F1}'}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Max Tokens:" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding DefaultMaxTokens, UpdateSourceTrigger=PropertyChanged}"
                                 Width="200"
                                 HorizontalAlignment="Left"
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="Top P:" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Slider Value="{Binding DefaultTopP}"
                                    Minimum="0"
                                    Maximum="1"
                                    Width="300"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DefaultTopP, StringFormat='{}{0:F2}'}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Default Provider:" Margin="0,0,0,2"/>
                        <!-- Bound to the registered providers rather than a
                             hardcoded list: ComboBoxItem children made
                             SelectedItem an object, which was persisted as
                             "System.Windows.Controls.ComboBoxItem: Ollama" and
                             could never match a provider name. -->
                        <ComboBox ItemsSource="{Binding ProviderOptions}"
                                  SelectedItem="{Binding DefaultProvider}"
                                  Width="200"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,0,20"/>

                        <Separator Margin="0,0,0,15"/>

                        <TextBlock Text="Context Window" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#666666" Margin="0,0,0,15"
                                   Text="Every message resends the whole conversation, so a long one eventually fills the model's context window and the request starts failing. Compacting folds the older messages into a summary to make room. They stay on screen and in the saved file, greyed out; only what is sent to the model gets shorter. The meter beside the Tools switch shows how full the window is."/>

                        <CheckBox Content="Compact automatically when the window fills up"
                                  IsChecked="{Binding AutoCompact}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="With this off, the meter still fills up but nothing happens until you press Compact."
                                   FontSize="11" Foreground="#666666" TextWrapping="Wrap" Margin="20,0,0,15"/>

                        <TextBlock Text="Compact at:" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Slider Value="{Binding CompactThresholdPercent}"
                                    Minimum="10"
                                    Maximum="100"
                                    Width="300"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CompactThresholdPercent, StringFormat='{}{0}% full'}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666666" Margin="0,0,0,15"
                                   Text="Leave room below 100%: the reply has to fit alongside the prompt, and compacting itself needs space to send what it is summarizing. The meter turns amber ten points before this and red on reaching it."/>

                        <TextBlock Text="Messages left untouched:" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding KeepRecentMessages, UpdateSourceTrigger=PropertyChanged}"
                                 Width="200"
                                 HorizontalAlignment="Left"
                                 Margin="0,0,0,4"/>
                        <TextBlock Text="The most recent messages are never summarized, since the exchange in progress is what the next answer depends on most."
                                   FontSize="11" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,15"/>

                        <TextBlock Text="Assumed window size (tokens):" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding FallbackWindowTokens, UpdateSourceTrigger=PropertyChanged}"
                                 Width="200"
                                 HorizontalAlignment="Left"
                                 Margin="0,0,0,4"/>
                        <TextBlock Text="Used for models whose provider does not report a context length. Ollama is the usual case - it serves models at 4096 tokens unless the modelfile says otherwise, so raise this only if you have configured yours for more."
                                   FontSize="11" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,15"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- UI Preferences Tab -->
            <TabItem Header="UI">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="User Interface Preferences" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <TextBlock Text="Font Size:" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Slider Value="{Binding FontSize}"
                                    Minimum="10"
                                    Maximum="20"
                                    Width="300"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FontSize}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <CheckBox Content="Show timestamps on messages"
                                  IsChecked="{Binding ShowTimestamps}"
                                  Margin="0,0,0,10"/>

                        <CheckBox Content="Enable markdown rendering"
                                  IsChecked="{Binding EnableMarkdown}"
                                  Margin="0,0,0,10"/>

                        <TextBlock Text="Sidebar Width (pixels):" Margin="0,10,0,2"/>
                        <TextBox Text="{Binding SidebarWidth, UpdateSourceTrigger=PropertyChanged}"
                                 Width="200"
                                 HorizontalAlignment="Left"
                                 Margin="0,0,0,15"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Templates Tab -->
            <TabItem Header="Modes">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Answering Modes" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <TextBlock Text="Each mode carries a standing instruction, sent ahead of the conversation on every message. Pick the mode in the main window, next to Provider and Model. A template's own system prompt is added after whichever of these is active."
                                   FontSize="12"
                                   Foreground="#666666"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="Chat" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ChatModePrompt, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="70"
                                 MaxHeight="140"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="8,6"
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="Coding" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CodingModePrompt, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="70"
                                 MaxHeight="140"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="8,6"
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="Scientific" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ScientificModePrompt, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="70"
                                 MaxHeight="140"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="8,6"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="Leave one empty to have that mode add nothing of its own."
                                   FontSize="11"
                                   Foreground="#999999"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Templates">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Prompt Templates" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <TextBlock Text="Use templates to quickly insert pre-configured prompts with optional system prompts."
                                   FontSize="12"
                                   Foreground="#666666"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,15"/>

                        <Button Content="📋 Open Template Manager"
                                x:Name="OpenTemplatesButton"
                                Padding="15,10"
                                Margin="0,0,0,15"
                                HorizontalAlignment="Left"
                                ToolTip="Open the template picker to manage and use templates (Ctrl+T)"/>

                        <TextBlock Text="Templates can also be opened directly from the chat window with Ctrl+T."
                                   FontSize="11"
                                   Foreground="#999999"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Projects: the folders the assistant may work in -->
            <TabItem Header="Projects">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                               Text="Projects" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <ListBox Grid.Row="1" Grid.Column="0"
                             ItemsSource="{Binding Projects}"
                             SelectedItem="{Binding SelectedProject}"
                             DisplayMemberPath="Name"
                             Margin="0,0,15,0"/>

                    <!-- Editor for whichever project is selected -->
                    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#666666" Margin="0,0,0,12"
                                       Text="A project is a folder the assistant may build and run in, together with how much it may do without asking. Adding one grants it permission for that folder - you do not need to list the path under Build tools as well."/>

                            <StackPanel Visibility="{Binding HasSelectedProject,
                                                     Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Name:" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedProject.Name, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,10"/>

                                <TextBlock Text="Folder:" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedProject.RootPath}"
                                         IsReadOnly="True"
                                         Background="#F5F5F5"
                                         FontFamily="Consolas, Courier New, monospace"
                                         Margin="0,0,0,10"/>

                                <TextBlock Text="How much it may do on its own:" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding AutonomyOptions}"
                                          SelectedItem="{Binding SelectedProject.Autonomy}"
                                          Width="220" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666666" Margin="0,0,0,12"
                                           Text="Manual is today's behaviour - one reply per message. StepApprove keeps working but stops to ask before each step. FullAuto carries on until it reports the task done or a budget runs out. Start with StepApprove until you have watched a model work on this project; a model that loops confidently into wrong work does the most damage unobserved."/>

                                <TextBlock Text="Stop after this many steps:" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedProject.MaxLoopIterations, UpdateSourceTrigger=PropertyChanged}"
                                         Width="120" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                                <TextBlock Text="Stop after this many minutes:" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedProject.MaxLoopMinutes, UpdateSourceTrigger=PropertyChanged}"
                                         Width="120" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                                <CheckBox Content="Take a git checkpoint before running unattended"
                                          IsChecked="{Binding SelectedProject.RequireGitCheckpoint}"
                                          Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666666" Margin="20,0,0,12"
                                           Text="Unattended work that writes files and runs programs needs a way back, and git is the way back that already exists. With this on, an automatic run will not start in a folder that is not a clean repository."/>

                                <TextBlock Text="Notes:" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedProject.Notes, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="60" MaxHeight="120"
                                         VerticalScrollBarVisibility="Auto"
                                         Margin="0,0,0,10"/>

                                <Button Content="Save project"
                                        Command="{Binding SaveProjectCommand}"
                                        Padding="15,6" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <TextBlock Text="Select a project on the left, or add one."
                                       Foreground="#999999" FontStyle="Italic"
                                       Visibility="{Binding HasSelectedProject,
                                                    Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Add..." Command="{Binding AddProjectCommand}"
                                Padding="12,5" Margin="0,0,8,0"/>
                        <Button Content="Remove" Command="{Binding RemoveProjectCommand}"
                                IsEnabled="{Binding HasSelectedProject}"
                                Padding="12,5"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{Binding ProjectStatus}"
                               FontSize="11" Foreground="#666666"
                               TextWrapping="Wrap" VerticalAlignment="Center"
                               Margin="0,10,0,0"/>
                </Grid>
            </TabItem>

            <!-- Build tools: lets the model compile and test local projects -->
            <TabItem Header="Build tools">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Build and Test Tools" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#666666" Margin="0,0,0,12"
                                   Text="Lets the assistant compile your projects and run their tests using the toolchains already installed - dotnet and MSBuild for Visual Studio work, the Gradle wrapper for Android Studio projects. It reads back the compiler errors, so it can fix a break and check the fix."/>

                        <Border Background="#FFF3E0" BorderBrush="#FFB74D" BorderThickness="1"
                                Padding="10" CornerRadius="4" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Read this before adding a folder" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#555555">
                                    Building a project runs that project's own scripts - MSBuild targets, build.gradle
                                    and pre-build events all execute code. Running its tests executes the project's code
                                    directly.<LineBreak/><LineBreak/>
                                    This assistant also reads web search results and files from MCP servers, so text it
                                    has been given could try to talk it into building something you did not intend. It
                                    can only ever act inside the folders listed below, so list only projects you already
                                    trust and would run yourself.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Project folders the assistant may build (one per line):" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding BuildAllowedRoots, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 MinHeight="80"
                                 MaxHeight="160"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, Courier New, monospace"
                                 Padding="6,4"
                                 Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666666" Margin="0,0,0,15"
                                   Text="Everything inside a listed folder is included. Leave this empty to switch the build tools off completely - which is the default, and while it is empty the tools are not offered to the model at all."/>

                        <CheckBox Content="Allow running tests, not just building"
                                  IsChecked="{Binding BuildAllowTests}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="Separate from building because a test suite runs your project's own code, while compiling it does not."
                                   FontSize="11" Foreground="#666666" TextWrapping="Wrap" Margin="20,0,0,15"/>

                        <TextBlock Text="Time limit per build or test run (seconds):" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding BuildTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                 Width="200"
                                 HorizontalAlignment="Left"
                                 Margin="0,0,0,4"/>
                        <TextBlock Text="When it runs out the command and everything it started are stopped, so a hung build cannot hold the conversation open."
                                   FontSize="11" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,15"/>

                        <TextBlock Text="dotnet executable:" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding BuildDotnetPath, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,4"/>
                        <TextBlock Text="Just 'dotnet' finds it on PATH. Give a full path if you have several SDKs and the wrong one is picked."
                                   FontSize="11" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,15"/>

                        <TextBlock Text="cmake executable (optional):" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding BuildCMakePath, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666666" Margin="0,0,0,15"
                                   Text="Leave empty for the usual case. The PATH is searched first, then every Visual Studio installation - Visual Studio bundles cmake but does not put it on the PATH, so it is invisible to anything not started from a developer command prompt. Set a full path only to force a particular copy. ctest is taken from the same folder."/>

                        <TextBlock Text="MSBuild.exe (optional):" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding BuildMsBuildPath, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666666" Margin="0,0,0,15"
                                   Text="Leave empty to always use dotnet. Point this at Visual Studio's MSBuild.exe if your solutions include classic .NET Framework projects, which dotnet build cannot build. It usually sits under ...\Microsoft Visual Studio\2022\Community\MSBuild\Current\Bin\MSBuild.exe"/>

                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#999999"
                                   Text="Android projects are built with the gradlew wrapper checked into the project, so Gradle itself does not need installing. Changes here take effect after a restart."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Storage Settings Tab -->
            <TabItem Header="Storage">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Storage Settings" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <TextBlock Text="Conversations Path:" Margin="0,0,0,2"/>
                        <TextBlock Text="Leave empty to use default (%APPDATA%/SNChat/conversations)"
                                   FontSize="11"
                                   Foreground="#666666"
                                   Margin="0,0,0,5"/>
                        <TextBox Text="{Binding ConversationsPath, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,15"/>

                        <CheckBox Content="Auto-save conversations"
                                  IsChecked="{Binding AutoSave}"
                                  Margin="0,0,0,10"/>

                        <TextBlock Text="Max conversations to keep:" Margin="0,10,0,2"/>
                        <TextBox Text="{Binding MaxConversationsToKeep, UpdateSourceTrigger=PropertyChanged}"
                                 Width="200"
                                 HorizontalAlignment="Left"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="Current storage location:" Margin="0,20,0,5" FontWeight="SemiBold"/>
                        <TextBlock Text="%APPDATA%\SNChat\"
                                   FontSize="11"
                                   Foreground="#666666"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Buttons -->
        <Border Grid.Row="1" Background="#F8F8F8" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="15">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="Reset to Defaults"
                            Command="{Binding ResetToDefaultsCommand}"
                            Padding="15,8"
                            Margin="0,0,10,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="• Unsaved changes"
                               Foreground="Orange"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"
                               Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Content="Save"
                            Command="{Binding SaveSettingsCommand}"
                            Padding="25,8"
                            Margin="0,0,10,0"
                            IsDefault="True"/>

                    <Button Content="Close"
                            Click="CloseButton_Click"
                            Padding="25,8"
                            IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
