<Window x:Class="SNChat.App.Views.TemplatePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:SNChat.App.ViewModels"
        mc:Ignorable="d"
        Title="Prompt Templates"
        Height="560"
        Width="860"
        WindowStartupLocation="CenterOwner"
        d:DataContext="{d:DesignInstance Type=viewmodels:TemplatePickerViewModel}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Template list -->
        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
            <TextBox DockPanel.Dock="Top"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,4"
                     Margin="0,0,0,8"
                     ToolTip="Filter by name, description, or category"/>

            <ListBox ItemsSource="{Binding Templates}"
                     SelectedItem="{Binding SelectedTemplate}"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#888888"/>
                            <TextBlock Text="{Binding Description}"
                                       FontSize="11"
                                       Foreground="#666666"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Variables and preview -->
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Fill in the blanks" FontWeight="SemiBold" Margin="0,0,0,6"/>

                <ItemsControl ItemsSource="{Binding Variables}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding DisplayName}" FontSize="11" Foreground="#555555"/>
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="26"
                                         MaxHeight="110"
                                         VerticalScrollBarVisibility="Auto"
                                         Padding="6,4"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="This template has no blanks to fill."
                           FontSize="11"
                           Foreground="#888888"
                           FontStyle="Italic">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Variables.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <DockPanel Grid.Row="1">
                <TextBlock DockPanel.Dock="Top" Text="Preview" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="3" Background="#FAFAFA">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                        <TextBlock Text="{Binding Preview}"
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas, Courier New"
                                   FontSize="12"
                                   Foreground="#333333"/>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>

        <!-- Buttons -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Templates live in %APPDATA%\SNChat\templates and can be edited by hand."
                           FontSize="10"
                           Foreground="#999999"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
                <Button Content="Cancel"
                        Click="CancelButton_Click"
                        Padding="20,6"
                        Margin="0,0,8,0"
                        IsCancel="True"/>
                <Button Content="Use template"
                        Command="{Binding AcceptCommand}"
                        Padding="20,6"
                        FontWeight="SemiBold"
                        IsDefault="True"
                        IsEnabled="{Binding SelectedTemplate, Converter={StaticResource NotNullConverter}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
